PORT=5000
NODE_ENV=development
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=1mb

# PostgreSQL — enables persistent storage (Prisma).
# Leave blank to use in-memory storage (data resets on restart).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/riddance?schema=public"

# Strava integration — get these from https://www.strava.com/settings/api
# Leave blank to disable Strava import.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5000/api/v1/integrations/strava/callback

# Frontend URL (used for post-OAuth redirects)
APP_URL=http://localhost:3000
